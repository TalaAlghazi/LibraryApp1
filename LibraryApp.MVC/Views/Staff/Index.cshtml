@using LibraryApp1.BusinessLogic
@model List<AuthenticatedUser>
@{
    ViewData["Title"] = "Staff";
}

<h2 class="mb-1">Staff</h2>
<p class="text-muted mb-3">Create accounts for librarians. Customers sign up themselves from the registration page.</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title mb-3">Add a librarian</h5>
                <form method="post" asp-action="Create">
                    <div class="mb-3">
                        <label for="staff-username" class="form-label">Username</label>
                        <input id="staff-username" type="text" name="username" class="form-control" required minlength="3" maxlength="50" />
                    </div>
                    <div class="mb-3">
                        <label for="staff-email" class="form-label">Email</label>
                        <input id="staff-email" type="email" name="email" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label for="staff-password" class="form-label">Password</label>
                        <input id="staff-password" type="password" name="password" class="form-control" autocomplete="new-password" required minlength="8" />
                    </div>
                    <div class="mb-3">
                        <label for="staff-confirm" class="form-label">Confirm password</label>
                        <input id="staff-confirm" type="password" name="confirmPassword" class="form-control" autocomplete="new-password" required minlength="8" />
                    </div>
                    <button type="submit" class="btn btn-primary">Create librarian</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title mb-3">Librarians</h5>
                @if (Model.Count == 0)
                {
                    <p class="text-muted mb-0">No librarian accounts yet.</p>
                }
                else
                {
                    <ul class="staff-list">
                        @foreach (var librarian in Model)
                        {
                            <li>
                                <strong>@librarian.Username</strong>
                                <span class="small text-muted">@librarian.Email</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>
