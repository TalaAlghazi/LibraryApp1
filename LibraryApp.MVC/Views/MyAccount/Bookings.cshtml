@using LibraryApp1.DataAccess
@model List<ReservationWithBookDto>
@{
    ViewData["Title"] = "My Account";
    ViewData["AccountTab"] = "Bookings";
}

<partial name="_AccountNav" />

@if (Model.Count == 0)
{
    <div class="text-center text-muted py-5 border rounded">
        <p class="mb-3">You have no current bookings.</p>
        <a asp-controller="Books" asp-action="Index" class="btn btn-primary">Browse books</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Book</th>
                    <th>Booked On</th>
                    <th>Return By</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    bool pending = r.Status == ReservationStatus.Pending;
                    bool overdue = r.Status == ReservationStatus.Active && r.DueDate < DateTime.Now;
                    <tr>
                        <td>
                            <a asp-action="Details" asp-route-id="@r.ReservationId">@r.BookTitle</a>
                            <div class="small text-muted">@r.BookAuthor</div>
                        </td>
                        <td>@r.ReservedAt.ToShortDateString()</td>
                        <td>@(pending ? "After pickup" : r.DueDate.ToShortDateString())</td>
                        <td>
                            @if (pending)
                            {
                                <span class="badge bg-warning text-dark">Awaiting pickup</span>
                            }
                            else if (r.Status == ReservationStatus.ReturnRequested)
                            {
                                <span class="badge bg-warning text-dark">Return requested</span>
                            }
                            else if (overdue)
                            {
                                <span class="badge bg-danger">Overdue</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Active</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (r.Status == ReservationStatus.Active)
                            {
                                <form method="post" asp-action="RequestReturn" asp-route-id="@r.ReservationId" class="d-inline"
                                      data-confirm="A librarian will confirm the return once the book is received." data-confirm-title="Return this book?" data-confirm-ok="Request return">
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Return</button>
                                </form>
                            }
                            else if (pending)
                            {
                                <span class="small text-muted">Collect at the library</span>
                            }
                            else
                            {
                                <span class="small text-muted">Awaiting staff confirmation</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="small text-muted">Requested books are held for you until you collect them. After you request a return, the book stays on your account until a staff member confirms they received it.</p>
}