@using LibraryApp1.DataAccess
@model List<ReservationWithBookDto>
@{
    ViewData["Title"] = "My Account";
    ViewData["AccountTab"] = "History";
}

<partial name="_AccountNav" />

@if (Model.Count == 0)
{
    <div class="text-center text-muted py-5 border rounded">
        <p class="mb-0">No past bookings yet. Returned books will appear here.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Book</th>
                    <th>Booked On</th>
                    <th>Due</th>
                    <th>Returned On</th>
                    <th>Fine</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>
                            <a asp-action="Details" asp-route-id="@r.ReservationId">@r.BookTitle</a>
                            <div class="small text-muted">@r.BookAuthor</div>
                        </td>
                        <td>@r.ReservedAt.ToShortDateString()</td>
                        <td>@r.DueDate.ToShortDateString()</td>
                        <td>@r.ReturnedAt?.ToShortDateString()</td>
                        <td>@(r.Fine > 0 ? r.Fine.ToString("0.00") : "—")</td>
                        <td>
                            @if (r.Fine > 0)
                            {
                                <span class="badge bg-secondary">Returned late</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Returned</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}