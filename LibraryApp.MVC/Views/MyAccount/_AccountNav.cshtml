@{
    var tab = ViewData["AccountTab"] as string;
}

<h2 class="mb-3">My Account</h2>

<ul class="nav nav-pills mb-4 flex-wrap gap-1">
    <li class="nav-item">
        <a class="nav-link @(tab == "Bookings" ? "active" : "")" asp-controller="MyAccount" asp-action="Bookings">Current Bookings</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(tab == "History" ? "active" : "")" asp-controller="MyAccount" asp-action="History">Booking History</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(tab == "Profile" ? "active" : "")" asp-controller="MyAccount" asp-action="Profile">My Profile</a>
    </li>
</ul>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}